NETWORK=mainnet-beta

# Safe defaults. Keep these until paper/dry-run tests pass.
MODE=paper
DRY_RUN=true
LIVE_TRADING_ENABLED=false

# Low-latency RPC endpoints. Put Helius first, then independent fallbacks.
RPC_ENDPOINT=
RPC_ENDPOINT_2=
RPC_ENDPOINT_3=

WEBSOCKET_ENDPOINT=
WEBSOCKET_ENDPOINT_2=
WEBSOCKET_PROVIDER=solana

# Helius
HELIUS_API_KEY=
HELIUS_RPC_URL=
HELIUS_WS_URL=

# Jupiter Swap API
# Current API endpoints; add JUPITER_API_KEY when using an API-key protected plan.
JUPITER_API_KEY=
QUOTE_API_URL=https://api.jup.ag/swap/v1/quote
SWAP_API_URL=https://api.jup.ag/swap/v1/swap
OUTPUT_MINT=So11111111111111111111111111111111111111112

# Never commit a private key. Prefer a local Solana keypair JSON file.
WALLET_KEYPAIR_PATH=

POSITION_MINT=
POSITION_DECIMALS=6
POSITION_AMOUNT=1000000
POSITION_ENTRY_PRICE=1

STOP_LOSS_ENABLED=true
STOP_LOSS_PCT=5
EARLY_EXIT_ENABLED=true
EARLY_EXIT_PCT=2
FALLING_MARKET_ENABLED=true
FALLING_WINDOW_MS=3000
FALLING_DROP_PCT=1.5
CONSECUTIVE_LOWER_TICKS=3

TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATION_PCT=20
TRAILING_STOP_PCT=8

TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_1_PCT=20
TAKE_PROFIT_1_SELL_PCT=25
TAKE_PROFIT_2_PCT=40
TAKE_PROFIT_2_SELL_PCT=25

MAX_PRICE_IMPACT_BPS=1500
MAX_SELL_RETRIES=3

PRIORITY_FEE_ENABLED=true
PRIORITY_FEE_MODE=dynamic
MIN_PRIORITY_FEE_MICROLAMPORTS=1000
MAX_PRIORITY_FEE_MICROLAMPORTS=50000
EMERGENCY_PRIORITY_FEE_MICROLAMPORTS=100000

QUOTE_SLIPPAGE_BPS=250
QUOTE_STALE_MS=1500
STALE_MARKET_MS=1500
DECISION_COOLDOWN_MS=500

SKIP_PREFLIGHT=false
RPC_MAX_RETRIES=2
CONFIRMATION_TIMEOUT_MS=30000
SIMULATION_LATENCY_MS=50
SAMPLE_DEBOUNCE_MS=150
WS_HEARTBEAT_MS=15000
LOG_LEVEL=info
