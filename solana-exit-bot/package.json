{
  "name": "solana-exit-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "benchmark": "tsx src/benchmark.ts",
    "rpc-load": "tsx src/rpcLoadBenchmark.ts",
    "paper": "MODE=paper tsx src/index.ts",
    "dry-run": "MODE=dry-run DRY_RUN=true tsx src/index.ts",
    "dry-run:real": "MODE=dry-run DRY_RUN=true tsx src/dryRun.ts",
    "live": "MODE=live DRY_RUN=false tsx src/index.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^16.4.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  }
}
